---
import "../styles/globals.css";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site, contactFormEnabled } from "../site-config";
import logoAnty from "../assets/images/logo-anty.png";

interface Props {
  title?: string;
  description?: string;
  path?: string;
  noindex?: boolean;
  ogImage?: string;
  ogImageAlt?: string;
}

const { title, description, path, noindex, ogImage, ogImageAlt } = Astro.props;

const organizationJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  // ページ側のJSON-LD（Serviceなど）から provider として参照できる共通ID
  "@id": `${site.url}/#organization`,
  name: site.name,
  alternateName: site.nameEn,
  url: site.url,
  // astro:assets 管理に伴いハッシュ付きURLになるため、ビルド後のURLから組み立てる
  logo: new URL(logoAnty.src, site.url).href,
  // フォーム運用中は構造化データにもメールアドレスを載せない
  ...(contactFormEnabled ? {} : { email: site.email }),
  contactPoint: {
    "@type": "ContactPoint",
    contactType: "customer service",
    url: `${site.url}/contact/`,
    availableLanguage: "Japanese",
  },
  foundingDate: site.founded,
  founder: { "@type": "Person", name: site.ceo },
  address: {
    "@type": "PostalAddress",
    addressCountry: "JP",
    addressRegion: site.address.region,
    addressLocality: site.address.locality,
    streetAddress: site.address.street,
  },
  sameAs: [
    site.store.url,
    site.instagram.url,
    ...site.shops.map((shop) => shop.url),
  ],
};

// 開発中のアクセスをGA4に混ぜたくないので、本番ビルドのときだけタグを出す。
const enableAnalytics = import.meta.env.PROD && Boolean(site.gaId);
---

<html lang="ja">
  <head>
    <BaseHead {title} {description} {path} {noindex} {ogImage} {ogImageAlt} />
    <slot name="head" />
  </head>
  <body>
    <a class="skipLink" href="#main">本文へスキップ</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />
    {
      enableAnalytics && (
        <script
          is:inline
          async
          src={`https://www.googletagmanager.com/gtag/js?id=${site.gaId}`}
        />
      )
    }
    {
      enableAnalytics && (
        <script is:inline define:vars={{ gaId: site.gaId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() {
            dataLayer.push(arguments);
          }
          gtag("js", new Date());
          gtag("config", gaId);
        </script>
      )
    }
  </body>
</html>
