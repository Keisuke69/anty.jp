---
import "../styles/globals.css";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../site-config.js";

const { title, description, canonical, noindex } = Astro.props;

const organizationJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: site.name,
  alternateName: site.nameEn,
  url: site.url,
  logo: `${site.url}/favicon.ico`,
  email: site.email,
  foundingDate: site.founded,
  founder: { "@type": "Person", name: site.ceo },
  address: {
    "@type": "PostalAddress",
    addressCountry: "JP",
    addressRegion: site.address.region,
    addressLocality: site.address.locality,
    streetAddress: site.address.street,
  },
  sameAs: [...site.shops.map((shop) => shop.url), site.instagram.url],
};

// 開発中のアクセスをGA4に混ぜたくないので、本番ビルドのときだけタグを出す。
const enableAnalytics = import.meta.env.PROD && Boolean(site.gaId);
---

<html lang="ja">
  <head>
    <BaseHead
      title={title}
      description={description}
      canonical={canonical}
      noindex={noindex}
    />
  </head>
  <body>
    <a class="skipLink" href="#main">本文へスキップ</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />
    {enableAnalytics && (
      <script
        is:inline
        async
        src={`https://www.googletagmanager.com/gtag/js?id=${site.gaId}`}
      ></script>
    )}
    {enableAnalytics && (
      <script
        is:inline
        set:html={`window.dataLayer = window.dataLayer || [];\nfunction gtag(){dataLayer.push(arguments);}\ngtag('js', new Date());\ngtag('config', '${site.gaId}');`}
      />
    )}
  </body>
</html>
