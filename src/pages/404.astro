---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
---

<Base title="ページが見つかりません" noindex>
  <PageHeader
    eyebrow="404"
    title="ページが見つかりません"
    lead="お探しのページは移動または削除された可能性があります。"
  />
  <section class="section404">
    <div class="container">
      <a class="textLink" href="/"><span>トップページへ戻る →</span></a>
    </div>
  </section>
</Base>

<style>
  .section404 {
    padding: 40px 0 88px;
  }
</style>
