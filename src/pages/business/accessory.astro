---
import { Picture } from "astro:assets";
import Base from "../../layouts/Base.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import PageHeader from "../../components/PageHeader.astro";
import styles from "../../styles/business-accessory.module.css";
import { site } from "../../site-config";
import photoCardsFour from "../../assets/images/photo-cards-four.jpg";
import photoCardsThree from "../../assets/images/photo-cards-three.jpg";
import photoDetailGold from "../../assets/images/photo-detail-gold.jpg";
import photoBooth from "../../assets/images/photo-booth.jpg";

// 表示幅の見積もり（額縁の 12px+1px を含めて container から引く。大きめ＝安全側に丸める）
// photoBand: コンテナ幅いっぱい / work: 899px超で420px固定カラム / meet: 899px超で2カラムの半分
const bandSizes = "(min-width: 1280px) 1110px, calc(100vw - 74px)";
const workSizes = "(min-width: 900px) 394px, calc(100vw - 74px)";
const meetSizes = "(min-width: 900px) 514px, calc(100vw - 74px)";

// テクノロジー事業ページと同じ形式のService。Organization は Base.astro の @id を参照する
const serviceJsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "アンティーク調ハンドメイドアクセサリーの製作・販売",
  serviceType: [
    "ハンドメイドアクセサリーの製作・販売",
    "アクセサリーの卸・お取り扱い",
    "イベント出展・ポップアップストア",
  ],
  provider: { "@id": `${site.url}/#organization` },
  brand: { "@type": "Brand", name: site.shortName },
  url: `${site.url}/business/accessory/`,
};
---

<Base
  title="ハンドメイドアクセサリー事業｜アンティーク調のピアス・イヤリング"
  description="アンティーク風の他にないデザインで、16kgpや本ロジウムコーティングを使用したピアス、イヤリング、ネックレスをお作りしております。金属アレルギーの方向けのチタン・樹脂・14kgfも多数ご用意しております。"
  path="/business/accessory/"
>
  <Breadcrumb
    items={[
      { label: "TOP", href: "/" },
      { label: "事業内容", href: "/#business" },
      { label: "ハンドメイドアクセサリー" },
    ]}
  />

  <PageHeader
    eyebrow="Handmade accessory"
    title="ハンドメイドアクセサリー事業"
    lead="「誰とも被らない自分を輝かせたい時のアンティーク調アクセサリー」をコンセプトに、パールやクリスタルを使用した右左で違うアシンメトリーなデザインの耳飾り等を制作しております。インポートのボタンを使用したブローチやヘアアクセサリー、ネックレス、ブレスレット等もご用意しております。"
  />

  <section class={styles.photoBand}>
    <div class="container">
      <div class="frame">
        <Picture
          src={photoCardsFour}
          formats={["avif"]}
          fallbackFormat="webp"
          widths={[640, 960, 1280, 1600]}
          sizes={bandSizes}
          alt="同じ形のアシンメトリーな耳飾りを、シルバー・黒・ゴールド・パールの四色で並べた台紙"
          class={styles.photoWide}
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <section class={styles.concept}>
    <div class={`container ${styles.conceptGrid}`}>
      <div>
        <span class="eyebrow">Concept</span>
        <h2 class="sectionTitle">三つの「時」に<br />向けてつくる</h2>
      </div>
      <div>
        <ol class={styles.momentList}>
          <li>
            <span class={styles.momentNo}>I</span>
            <span class={styles.momentText}>アクセサリーを選んで頂く時に。</span>
          </li>
          <li>
            <span class={styles.momentNo}>II</span>
            <span class={styles.momentText}>開封して頂く時に。</span>
          </li>
          <li>
            <span class={styles.momentNo}>III</span>
            <span class={styles.momentText}>身に付けて頂く時に。</span>
          </li>
        </ol>
        <p class={styles.conceptClose}>
          少しでも明るく華やかな気持ちになって頂けるように、心を込めて一点一点丁寧にお作りしております。
        </p>
      </div>
    </div>
  </section>

  <section class={styles.works}>
    <div class="container">
      <div class={`sectionHead ${styles.worksHead}`}>
        <span class="eyebrow">Works</span>
        <h2 class="sectionTitle sectionTitle--lg">作品のこと</h2>
        <p class="sectionLead">
          作品の一部をご紹介しております。在庫は公式オンラインストアをご覧下さい。
        </p>
      </div>

      <div class={styles.workList}>
        <article class={`${styles.work} ${styles.workReverse}`}>
          <div class={styles.workText}>
            <span class="noLabel">No. 01</span>
            <h3 class={styles.workTitle}>透かしと、粒の輪</h3>
            <p class={styles.workBody}>
              古い金具の意匠から起こした透かしの飾りを片方に、金の粒を留めた輪をもう片方にあしらった耳飾りです。下がりの雫だけ色を揃えて、右左の形の違いを対として楽しんで頂けるようにお作りしております。シルバー、ゴールド、白い雫の三通りをご用意しております。装飾は多めですが、軽く身に付けて頂けます。
            </p>
          </div>
          <div class="frame frame--soft">
            <Picture
              src={photoCardsThree}
              formats={["avif"]}
              fallbackFormat="webp"
              widths={[400, 800, 1200, 1400]}
              sizes={workSizes}
              alt="透かしの飾りと粒の輪を対にしたアシンメトリーな耳飾り。シルバー、ゴールド、白い雫の三色"
              class={styles.workPhoto}
              loading="lazy"
            />
          </div>
        </article>
        <article class={styles.work}>
          <div class="frame frame--soft">
            <Picture
              src={photoDetailGold}
              formats={["avif"]}
              fallbackFormat="webp"
              widths={[400, 800, 1200, 1600]}
              sizes={workSizes}
              alt="金の花座にコットンパールを据え、クリスタルと細い鎖を垂らした耳飾り"
              class={`${styles.workPhoto} ${styles.workPhotoGold}`}
              loading="lazy"
            />
          </div>
          <div class={styles.workText}>
            <span class="noLabel">No. 02</span>
            <h3 class={styles.workTitle}>金の花座と、コットンパール</h3>
            <p class={styles.workBody}>
              大ぶりに見えて、実際にはとても軽い一組です。コットンパールを金の花座に据え、片方は月と雫、もう片方は細い鎖を長く垂らしております。フォーマルなシーンで身に付けて頂ける華やかさと、一日身に付けて頂ける軽さの両方を目指してお作りしております。
            </p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class={styles.materials}>
    <div class={`container ${styles.materialsGrid}`}>
      <div>
        <span class="eyebrow">Materials</span>
        <h2 class="sectionTitle">素材と金具</h2>
        <p class={styles.materialsText}>
          輝きが長持ちし、アレルギー反応も出にくい素材を選んでおります。金属アレルギーの方向けの金具も種類多数ご用意ございますので、お気軽にご連絡下さい。
        </p>
      </div>
      <dl class="defList">
        <div>
          <dt>金具</dt>
          <dd>サージカルステンレス／16kgp／本ロジウムコーティング</dd>
        </div>
        <div>
          <dt>アレルギー対応</dt>
          <dd>チタン／樹脂ピアス・イヤリング／14kgf</dd>
        </div>
        <div>
          <dt>石とパーツ</dt>
          <dd>パール／クリスタル／ストーン／金属パーツ／インポートのボタン</dd>
        </div>
        <div>
          <dt>つくるもの</dt>
          <dd>耳飾り（ピアス・イヤリング）／ネックレス／ブレスレット／ブローチ／ヘアアクセサリー</dd>
        </div>
        <div>
          <dt>合わせる場面</dt>
          <dd>カジュアルな普段使いから、大切なフォーマルなシーンまで</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class={styles.buy}>
    <div class="container">
      <div class={styles.buyInner}>
        <div class="sectionHead">
          <span class="eyebrow">Where to buy</span>
          <h2 class="sectionTitle">買える場所</h2>
        </div>
        <div class={styles.buyGrid}>
          <a
            class={`${styles.buyCard} ${styles.buyCardPrimary}`}
            href={site.store.url}
            target="_blank"
            rel="noopener"
          >
            <span class={styles.buyLabel}>公式オンラインストア</span>
            <strong class={styles.buyNamePrimary}>{site.store.name} ↗</strong>
            <span class={styles.buyDomain}>{site.store.domainLabel}</span>
            <span class={styles.buyDesc}>
              在庫のある作品はこちらからご購入頂けます。金具の変更やアレルギー対応のご相談も承っております。
            </span>
          </a>
          {
            site.shops.map((shop) => (
              <a
                class={styles.buyCard}
                href={shop.url}
                target="_blank"
                rel="noopener"
              >
                <strong class={styles.buyName}>{shop.name} ↗</strong>
                <span class={styles.buyDomain}>{shop.description}</span>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class={styles.meet}>
    <div class={`container ${styles.meetGrid}`}>
      <div class="frame frame--soft">
        <Picture
          src={photoBooth}
          formats={["avif"]}
          fallbackFormat="webp"
          widths={[520, 1040, 1400]}
          sizes={meetSizes}
          alt="イベント出展のブース。金の織物を背景に、耳飾りとネックレスを並べた台"
          class={styles.meetPhoto}
          loading="lazy"
        />
      </div>
      <div>
        <span class="eyebrow">Where to meet</span>
        <h2 class="sectionTitle">出会える場所</h2>
        <p class={styles.meetText}>
          写真では伝わらない大きさや軽さを直接お手に取ってご覧頂けるよう、イベント出展やポップアップストアも行っております。出展の予定はInstagramでお知らせしております。
        </p>
        <div class={styles.meetCards}>
          <a
            class={styles.instagramCard}
            href={site.instagram.url}
            target="_blank"
            rel="noopener"
          >
            <strong class={styles.instagramName}>
              Instagram {site.instagram.handle} ↗
            </strong>
            <span class={styles.instagramNote}>{site.instagram.description}</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(serviceJsonLd)}
  />
</Base>
