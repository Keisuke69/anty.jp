---
import Base from "../layouts/Base.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import PageHeader from "../components/PageHeader.astro";
import styles from "../styles/contact.module.css";
import { site, contactFormEnabled } from "../site-config";

// フォームの「お問い合わせ種別」の選択肢もこの並びをそのまま使う
const topics = [
  {
    title: "商品について",
    text: "アクセサリーの仕様やお届けについてのご質問。ご注文済みの商品については、ご購入いただいたショップからのご連絡が確実です。",
  },
  {
    title: "卸・お取り扱いのご相談",
    text: "店舗での取り扱い、イベント出店、アクセサリーパーツの卸についてのご相談。",
  },
  {
    title: "開発・技術支援のご相談",
    text: "システム開発、プロダクト開発の相談、開発チームへの参画や技術顧問のご依頼。",
  },
  {
    title: "取材・その他",
    text: "取材、協業のご提案、採用に関するお問い合わせなど。",
  },
];

// フォームでは名前とメールアドレスが入力欄になるので、内容についてのお願いだけ残す
const checklist = contactFormEnabled
  ? [
      "お困りごとやご要望の具体的な内容",
      "ご希望の時期や予算感（開発のご相談の場合、決まっていれば）",
    ]
  : [
      "貴社名・お名前（個人のお客さまはお名前のみで結構です）",
      "ご返信先のメールアドレス",
      "お問い合わせの内容（お困りごとやご要望）",
      "ご希望の時期や予算感（開発のご相談の場合、決まっていれば）",
    ];
---

<Base
  title="お問い合わせ"
  description="株式会社Antyへのお問い合わせ。商品・卸のご相談、システム開発や技術支援のご相談は、こちらのページから承っています。"
  path="/contact/"
>
  <Breadcrumb items={[{ label: "TOP", href: "/" }, { label: "お問い合わせ" }]} />

  <PageHeader
    eyebrow="Contact"
    title="お問い合わせ"
    lead={
      contactFormEnabled
        ? "どちらの事業についても、下のフォームから承っています。数日以内にご返信します。"
        : "どちらの事業についても、メールで承っています。数日以内にご返信します。"
    }
  />

  {
    contactFormEnabled ? (
      <section class={styles.form}>
        <div class="container">
          <form
            class={styles.formCard}
            action={site.contactFormAction}
            method="POST"
            accept-charset="UTF-8"
          >
            <span class={styles.formLabel}>Contact form</span>
            <div class={styles.fieldGrid}>
              <div class={styles.field}>
                <label for="contact-name">
                  お名前<span class={styles.required}>必須</span>
                </label>
                <input id="contact-name" name="name" type="text" required autocomplete="name" />
              </div>
              <div class={styles.field}>
                <label for="contact-company">貴社名</label>
                <input
                  id="contact-company"
                  name="company"
                  type="text"
                  autocomplete="organization"
                />
              </div>
            </div>
            <div class={styles.field}>
              <label for="contact-email">
                メールアドレス（ご返信先）<span class={styles.required}>必須</span>
              </label>
              <input id="contact-email" name="email" type="email" required autocomplete="email" />
            </div>
            <div class={styles.field}>
              <label for="contact-subject">
                お問い合わせ種別<span class={styles.required}>必須</span>
              </label>
              <select id="contact-subject" name="subject" required>
                <option value="">選択してください</option>
                {topics.map((topic) => (
                  <option value={topic.title}>{topic.title}</option>
                ))}
              </select>
            </div>
            <div class={styles.field}>
              <label for="contact-message">
                お問い合わせ内容<span class={styles.required}>必須</span>
              </label>
              <textarea id="contact-message" name="message" rows="8" required />
            </div>
            {/* スパムボット向けの罠。人間には見えない欄で、入力されていたら弾く */}
            <div class={styles.trap} aria-hidden="true">
              <label>
                この欄は空のままにしてください
                <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
              </label>
            </div>
            <button class={styles.submit} type="submit">
              送信する
            </button>
            <p class={styles.formNote}>ご入力いただいた情報は、お問い合わせへの対応にのみ使用します。</p>
          </form>
        </div>
      </section>
    ) : (
      <section class={styles.mail}>
        <div class="container">
          <div class={styles.mailCard}>
            <span class={styles.mailLabel}>Email</span>
            <a class={styles.mailAddress} href={`mailto:${site.email}`}>
              {site.email}
            </a>
            <p class={styles.mailNote}>クリックするとメールソフトが開きます。</p>
          </div>
        </div>
      </section>
    )
  }

  <section class={styles.topics}>
    <div class="container">
      <div class={`sectionHead ${styles.topicsHead}`}>
        <span class="eyebrow">Topics</span>
        <h2 class="sectionTitle">お問い合わせの例</h2>
      </div>
      <div class={styles.topicGrid}>
        {
          topics.map((topic) => (
            <div class={styles.topic}>
              <h3 class={styles.topicTitle}>{topic.title}</h3>
              <p class={styles.topicText}>{topic.text}</p>
            </div>
          ))
        }
      </div>
      <p class={styles.shopNote}>
        商品に関するご質問は、
        <a href={site.store.url} target="_blank" rel="noopener">
          オンラインストア
        </a>
        {
          site.shops.map((shop) => (
            <span>
              ・
              <a href={shop.url} target="_blank" rel="noopener">
                {shop.name}
              </a>
            </span>
          ))
        }
        の各ショップページからもお送りいただけます。
      </p>
    </div>
  </section>

  <section class={styles.before}>
    <div class={`container ${styles.beforeGrid}`}>
      <div>
        <span class="eyebrow">Before you write</span>
        <h2 class="sectionTitle">お書き添えいただきたいこと</h2>
      </div>
      <ul class={styles.checkList}>
        {checklist.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>
</Base>
