---
import Base from "../layouts/Base.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import PageHeader from "../components/PageHeader.astro";
import ContactCta from "../components/ContactCta.astro";
import styles from "../styles/about.module.css";
import { site, contactFormEnabled } from "../site-config";

// 値が入っている項目だけを表示する（資本金などは site-config.ts に追記すると出ます）
const rows = [
  { term: "名称", value: `${site.name}（英語表記: ${site.nameEn}）` },
  { term: "所在地", value: site.address.full },
  { term: "設立", value: site.foundedLabel },
  { term: "資本金", value: site.capital },
  { term: "代表取締役", value: site.ceo },
  { term: "決算期", value: site.fiscalYearEnd },
  { term: "電話番号", value: site.phone },
].filter((row) => row.value);
---

<Base
  title="会社概要"
  description="株式会社Anty（Anty, Inc.）の会社概要。2021年2月設立。ハンドメイドアクセサリー事業とテクノロジー事業を横浜・桜木町から営んでいます。"
  path="/about/"
>
  <Breadcrumb items={[{ label: "TOP", href: "/" }, { label: "会社概要" }]} />

  <PageHeader
    eyebrow="Company"
    title="会社概要"
    lead="2021年に設立。横浜・桜木町の小さな机の上から、装身具と仕組みの両方をつくっています。"
  />

  <section class={styles.profile}>
    <div class="container">
      <dl class={`defList ${styles.profileList}`}>
        {
          rows.map((row) => (
            <div>
              <dt>{row.term}</dt>
              <dd>{row.value}</dd>
            </div>
          ))
        }
        <div>
          <dt>お問い合わせ</dt>
          <dd>
            {
              contactFormEnabled ? (
                <a class={styles.mailLink} href="/contact/">
                  お問い合わせフォーム
                </a>
              ) : (
                <a class={styles.mailLink} href={`mailto:${site.email}`}>
                  {site.email}
                </a>
              )
            }
          </dd>
        </div>
        <div>
          <dt>事業内容</dt>
          <dd>
            <ul class={styles.purposeList}>
              {site.purposes.map((purpose) => <li>{purpose}</li>)}
            </ul>
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <section class={styles.business}>
    <div class="container">
      <div class={`sectionHead ${styles.businessHead}`}>
        <span class="eyebrow">Business</span>
        <h2 class="sectionTitle">事業紹介</h2>
      </div>
      <div class={styles.businessGrid}>
        <a class={styles.businessCard} href="/business/accessory/">
          <span class={styles.businessLabel}>Handmade accessory</span>
          <strong class={styles.businessName}>ハンドメイドアクセサリー事業 →</strong>
          <span class={styles.businessDesc}>
            アンティーク調のアクセサリーを、企画から製作、販売まで。
          </span>
        </a>
        <a class={styles.businessCard} href="/business/technology/">
          <span class={styles.businessLabel}>Technology</span>
          <strong class={styles.businessName}>テクノロジー事業 →</strong>
          <span class={styles.businessDesc}>
            技術顧問・アドバイザリーを中心に、コンサルティング、開発、開発支援。
          </span>
        </a>
      </div>
    </div>
  </section>

  <ContactCta
    eyebrow="Contact"
    title="お問い合わせ"
    text="事業に関するご相談、お取引の確認などはこちらから。"
  />
</Base>
