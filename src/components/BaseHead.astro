---
import { site } from "../site-config";

// title はページ名（「｜株式会社Anty」を付けて出力）。トップページは省略して既定のタイトルを使う。
// path は canonical と og:url に使う。404 のように canonical を持たないページでは省略する。
// ogImage / ogImageAlt はページ固有のOG画像に差し替えたいときだけ指定する（テクノロジー事業など）。
interface Props {
  title?: string;
  description?: string;
  path?: string;
  noindex?: boolean;
  ogImage?: string;
  ogImageAlt?: string;
}

const {
  title,
  description = site.description,
  path,
  noindex = false,
  ogImage: ogImagePath = "/images/og-image.jpg",
  ogImageAlt = "金の花座にコットンパールを据えた、Antyのアシンメトリーな耳飾り",
} = Astro.props;

const defaultTitle = `${site.name}｜アンティーク調ハンドメイドアクセサリーと技術支援`;
const fullTitle = title ? `${title}｜${site.name}` : defaultTitle;
const canonical = path ? new URL(path, site.url).href : null;
const ogImage = new URL(ogImagePath, site.url).href;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
{noindex && <meta name="robots" content="noindex" />}
<title>{fullTitle}</title>
<meta name="description" content={description} />
{canonical && <link rel="canonical" href={canonical} />}
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
{canonical && <meta property="og:url" content={canonical} />}
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content="ja_JP" />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogImageAlt} />
<meta property="og:type" content="website" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<link rel="icon" href="/favicon.ico" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Shippori+Mincho:wght@400;500;600&family=Noto+Sans+JP:wght@400;500&display=swap"
  rel="stylesheet"
/>
{
  // 確認コードが空のときは meta タグを出力しない
  site.googleSiteVerification && (
    <meta name="google-site-verification" content={site.googleSiteVerification} />
  )
}
