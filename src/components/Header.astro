---
import { Image } from "astro:assets";
import styles from "./Header.module.css";
import { nav } from "../site-config";
import logoAnty from "../assets/images/logo-anty.png";

// 現在ページに該当するナビ項目を濃い茶で示す（事業詳細ページでは「事業内容」）
const pathname = Astro.url.pathname;
const activeLabel = pathname.startsWith("/business")
  ? "事業内容"
  : pathname.startsWith("/about")
    ? "会社概要"
    : pathname.startsWith("/contact")
      ? "お問い合わせ"
      : pathname === "/"
        ? "TOP"
        : null;
---

<header class={styles.header}>
  <a href="/" aria-label="株式会社Anty トップへ">
    <Image
      class={styles.logo}
      src={logoAnty}
      alt="株式会社Anty"
      width={182}
      densities={[1, 2]}
      format="webp"
      loading="eager"
    />
  </a>
  <nav class={styles.nav} aria-label="メインナビゲーション">
    <ul>
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              class={item.label === activeLabel ? styles.active : undefined}
              aria-current={item.label === activeLabel ? "page" : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
