---
import styles from "./Footer.module.css";
import { nav, site } from "../site-config";

const year = new Date().getFullYear();

// 住所テキストはTOPのみ。アクセサリーページは直前の区画が #f5efe1 なので地色を紙色に揃える。
const pathname = Astro.url.pathname;
const showAddress = pathname === "/";
const isPaper = pathname.startsWith("/business/accessory");
---

<footer class={`${styles.footer} ${isPaper ? styles.paper : ""}`}>
  <div class={styles.inner}>
    <img
      class={styles.logo}
      src="/images/logo-anty.png"
      alt="株式会社Anty"
      width="1032"
      height="466"
      loading="lazy"
    />
    {
      showAddress && (
        <p class={styles.address}>
          {site.name}　{site.address.full}
        </p>
      )
    }
    <ul class={styles.links}>
      {
        nav.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))
      }
      <li>
        <a href={site.store.url} target="_blank" rel="noopener">
          オンラインストア ↗
        </a>
      </li>
      <li>
        <a href={site.instagram.url} target="_blank" rel="noopener">
          Instagram ↗
        </a>
      </li>
    </ul>
    <p class={styles.copyright}>© 2021–{year} {site.nameEn}</p>
  </div>
</footer>
