---
import styles from "./Footer.module.css";
import { nav, site } from "../site-config";

const year = new Date().getFullYear();
---

<footer class={styles.footer}>
  <div class="container">
    <div class={styles.grid}>
      <div>
        <p class={styles.brand}>Anty</p>
        <address class={styles.address}>
          {site.name}
          <br />
          {site.address.full}
          <br />
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </address>
      </div>

      <div>
        <p class={styles.heading}>Site</p>
        <ul class={styles.list}>
          {
            nav.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class={styles.heading}>Accessory</p>
        <ul class={styles.list}>
          {
            site.shops.map((shop) => (
              <li>
                <a
                  class={styles.external}
                  href={shop.url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {shop.name}
                </a>
              </li>
            ))
          }
          <li>
            <a
              class={styles.external}
              href={site.instagram.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              Instagram
            </a>
          </li>
        </ul>
      </div>
    </div>

    <p class={styles.bottom}>
      © 2021–{year} {site.nameEn}
    </p>
  </div>
</footer>
