---
import { Image } from "astro:assets";
import styles from "./Footer.module.css";
import { site } from "../site-config";
import logoAnty from "../assets/images/logo-anty.png";

// フッターは全ページ共通の内部リンクとして、事業詳細ページへ直接リンクする
// （ヘッダーの「事業内容」はトップのセクション行きなので、ここが唯一の全ページ導線）
const footerNav = [
  { href: "/", label: "TOP" },
  { href: "/business/accessory/", label: "ハンドメイドアクセサリー事業" },
  { href: "/business/technology/", label: "テクノロジー事業" },
  { href: "/about/", label: "会社概要" },
  { href: "/contact/", label: "お問い合わせ" },
];

const year = new Date().getFullYear();

// 住所テキストはTOPのみ。アクセサリーページは直前の区画が #f5efe1 なので地色を紙色に揃える。
const pathname = Astro.url.pathname;
const showAddress = pathname === "/";
const isPaper = pathname.startsWith("/business/accessory");
---

<footer class={`${styles.footer} ${isPaper ? styles.paper : ""}`}>
  <div class={styles.inner}>
    <Image
      class={styles.logo}
      src={logoAnty}
      alt="株式会社Anty"
      width={182}
      densities={[1, 2]}
      format="webp"
      loading="lazy"
    />
    {
      showAddress && (
        <p class={styles.address}>
          {site.name}　{site.address.full}
        </p>
      )
    }
    <ul class={styles.links}>
      {
        footerNav.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))
      }
      <li>
        <a href={site.store.url} target="_blank" rel="noopener">
          オンラインストア ↗
        </a>
      </li>
      <li>
        <a href={site.instagram.url} target="_blank" rel="noopener">
          Instagram ↗
        </a>
      </li>
    </ul>
    <p class={styles.copyright}>© 2021–{year} {site.nameEn}</p>
  </div>
</footer>
