---
import styles from "./PageHeader.module.css";

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
}

const { eyebrow, title, lead } = Astro.props;
---

<div class={styles.header}>
  <div class="container">
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1 class={styles.title}>{title}</h1>
    {lead && <p class={styles.lead}>{lead}</p>}
  </div>
</div>
