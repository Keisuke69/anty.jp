---
import styles from "./ContactCta.module.css";
import { site, contactFormEnabled } from "../site-config";

// 濃い茶のお問い合わせ帯。TOPと各事業ページの末尾で共通。
interface Props {
  eyebrow?: string;
  title: string;
  text: string;
  id?: string;
}

const { eyebrow, title, text, id } = Astro.props;
---

<section class={styles.cta} id={id}>
  <div class="container">
    {eyebrow && <span class={styles.eyebrow}>{eyebrow}</span>}
    <h2 class={styles.title}>{title}</h2>
    <p class={styles.text}>{text}</p>
    <div class="buttonRow">
      <a class="button" href="/contact/">お問い合わせ</a>
      {
        !contactFormEnabled && (
          <a class="button button--ghost" href={`mailto:${site.email}`}>
            {site.email}
          </a>
        )
      }
    </div>
  </div>
</section>
